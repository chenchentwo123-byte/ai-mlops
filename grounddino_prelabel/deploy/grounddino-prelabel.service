[Unit]
Description=Grounding DINO prelabel (Gradio + same-GPU workers)
Documentation=file:///home/chenchen/ssd/grounddino_prelabel/README.md
After=network-online.target redis-server.service redis.service postgresql.service
Wants=network-online.target
# Redis 本机必须先起来；没有对应 unit 时 systemd 会忽略。

[Service]
Type=simple
User=chenchen
Group=chenchen
WorkingDirectory=/home/chenchen/ssd/grounddino_prelabel

Environment=HOME=/home/chenchen
Environment=USER=chenchen
Environment=LANG=C.UTF-8
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/chenchen/ssd/grounddino_prelabel
Environment=CONDA_PREFIX=/home/chenchen/miniconda3/envs/ai-mlops
Environment=CONDA_DEFAULT_ENV=ai-mlops
Environment=PATH=/home/chenchen/miniconda3/envs/ai-mlops/bin:/home/chenchen/miniconda3/condabin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1

# -u：日志立刻落盘，不等缓冲
ExecStart=/home/chenchen/miniconda3/envs/ai-mlops/bin/python -u app.py
ExecStop=/bin/kill -TERM $MAINPID
TimeoutStartSec=0
TimeoutStopSec=30
Restart=on-failure
RestartSec=8
KillMode=control-group
KillSignal=SIGTERM

# 权重加载 + 3 份 replica 会占不少时间 / 内存
LimitNOFILE=65535
Nice=5

StandardOutput=append:/home/chenchen/ssd/grounddino_prelabel/logs/app.log
StandardError=append:/home/chenchen/ssd/grounddino_prelabel/logs/app.err.log
SyslogIdentifier=grounddino-prelabel

[Install]
WantedBy=multi-user.target
